{
  "manifest_version": 3,
  "name": "WhatsApp Web Privacy Shield",
  "short_name": "WA Privacy",
  "version": "1.0.0",
  "description": "Ekstensi privasi WhatsApp Web: blur pesan, preview, foto, nama & media. Terbuka saat di-hover atau chat dibuka.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WhatsApp Web Privacy Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-privacy": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "Nyalakan / Matikan Blur Privasi WhatsApp"
    }
  }
}

